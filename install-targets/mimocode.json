{
  "schema_version": 1,
  "package": "topmind",
  "target": "mimocode",
  "daily_entry": "topmind",
  "metadata": {
    "license": "MIT",
    "authors": [
      "TopMindSpace"
    ],
    "repository": "https://github.com/topmindspace/topmind-skills",
    "homepage": "https://github.com/topmindspace/topmind-skills#readme"
  },
  "skills": [
    "topmind",
    "topmind-capture",
    "topmind-organize",
    "topmind-write",
    "topmind-memory",
    "topmind-maintain",
    "topmind-loop",
    "topmind-weread",
    "topmind-x",
    "topmind-ledger",
    "topmind-wechat"
  ],
  "install_strategy": "symlink-or-copy",
  "target_root_hint": "mimocode-skills-root",
  "capabilities": [
    "skills"
  ],
  "content_truth": "topmind-workspace/categories-and-topics",
  "host_must_not": [
    "change-content-truth",
    "add-daily-entrypoints",
    "fork-skill-semantics",
    "persist-content-in-agent-state",
    "introduce-legacy-project-naming",
    "introduce-project_type-field"
  ],
  "config_shape": {
    "skills_root": "host-provided",
    "workspace_root": "host-provided"
  },
  "notes": [
    "MiMoCode / MiMo Desktop: project root .mimocode/skills, global root ~/.config/mimocode/skills.",
    "Brand root ~/.agents/skills may also be scanned — canonical install already covers it.",
    "Single daily entry topmind. v4.3 progressive disclosure."
  ],
  "install": {
    "script": "bin/install-skills.mjs",
    "docs": "INSTALL.md",
    "model": "canonical-.agents-skills + agent-link",
    "matrix": "node bin/install-skills.mjs add topmindspace/topmind-skills -g -a mimocode",
    "from_git": "node bin/install-skills.mjs add topmindspace/topmind-skills -g -a mimocode",
    "from_release": "node bin/install-skills.mjs add release:latest -g -a mimocode",
    "single_dir": "node bin/install-skills.mjs add topmindspace/topmind-skills --dest ~/.config/mimocode/skills"
  }
}
