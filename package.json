  "type": "module",
  "license": "MIT",
  "author": "TopMindSpace",
  "repository": {
    "type": "git",
    "url": "https://github.com/topmindspace/topmind-skills.git"
  },
  "homepage": "https://github.com/topmindspace/topmind-skills#readme",
